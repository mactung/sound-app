{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "components": ["./components"],
      "app": ["./app"],
      "types": ["./types"],
      "store": ["./store"],
      "utils": ["./utils"],
      "screens": ["./screens"],
      "theme": ["./theme"],
      "navigation": ["./navigation"],
      "assets": ["./assets"],
      "config": ["./config"],
      "hooks": ["./hooks"],
      "styles": ["./styles"],
      "static": ["./static"],
      "i18n": ["./i18n"],
      "models": ["./models"],
      "services": ["./services"],
      "components/*": ["./components/*"],
      "utils/*": ["./utils/*"],
      "store/*": ["./store/*"],
      "screens/*": ["./screens/*"],
      "navigation/*": ["./navigation/*"],
      "assets/*": ["./assets/*"],
      "hooks/*": ["./hooks/*"],
      "styles/*": ["./styles/*"],
      "models/*": ["./models/*"],
      "services/*": ["./services/*"]
    }
  },
  "include": ["src", "App.tsx", "index.js"]
}
